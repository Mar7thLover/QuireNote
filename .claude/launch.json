{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@quirenote/web", "dev"],
      "port": 5173,
      "env": { "QUIRENOTE_API_TARGET": "http://localhost:8790" }
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@quirenote/server", "start"],
      "port": 8790,
      "env": { "PORT": "8790", "QUIRENOTE_DATA_DIR": "data-dev" }
    }
  ]
}
