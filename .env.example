# ── QuireNote 服务端配置示例 ──
# 复制为 .env 后按需修改。不要把真实 Key 提交到仓库。

# 监听端口
PORT=8787
# 数据目录（SQLite 数据库、原始文件、生成的媒体）
QUIRENOTE_DATA_DIR=./data
# 用于加密 API Key 的主密钥（32 字节以上随机字符串）。留空则在数据目录自动生成 secret.key
QUIRENOTE_SECRET=

# ── 启动时自动添加的模型服务（可选）──
# 也可以只在「设置 → 模型与服务」里添加。每个变量都支持 *_FILE 形式（Docker secrets），
# 值为文件路径，服务端读取文件内容作为 Key。
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_key
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
